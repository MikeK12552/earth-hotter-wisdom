{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly climate security digest",
  "type": "object",
  "required": ["schema_version", "id", "week_start", "week_end", "week_number", "standfirst", "foundational", "developments", "salience", "moves", "watch", "continuity"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The week_end date. Also the filename." },
    "week_start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "week_end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "week_number": { "type": "integer" },
    "standfirst": { "type": "string", "description": "One or two sentences. Shown in the list. Written for a reader who has not read previous weeks." },
    "orientation": { "type": "string", "description": "Optional. Short note telling a new reader how to read this digest." },
    "housekeeping": { "type": "string", "description": "Optional markdown. Constraint notes, prompt problems, word count overruns." },
    "word_count": { "type": "integer" },

    "pushback": {
      "type": "object",
      "description": "Optional. Correction of the reader's framing.",
      "required": ["target", "text"],
      "properties": {
        "target": { "type": "string" },
        "text": { "type": "string" }
      }
    },

    "foundational": {
      "type": "array",
      "description": "Section A. Curriculum reading.",
      "items": {
        "type": "object",
        "required": ["phase", "citation", "summary"],
        "properties": {
          "phase": { "type": "string", "description": "Curriculum phase, e.g. '1' or '5/6 bridge'." },
          "kind": { "type": "string", "enum": ["conceptual", "empirical", "methodological", "critique"] },
          "citation": { "$ref": "#/$defs/citation" },
          "summary": { "type": "string" },
          "critiques": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "developments": {
      "type": "array",
      "description": "Section B. Events of the week.",
      "items": {
        "type": "object",
        "required": ["n", "title", "date", "scope", "body", "arc", "nl_eu", "sources"],
        "properties": {
          "n": { "type": "integer" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "place": { "type": "string" },
          "scope": { "type": "string", "enum": ["global", "multilateral", "eu", "nl", "us", "global/us", "other"] },
          "body": { "type": "string" },
          "arc": { "type": "string", "enum": ["novel", "repeat", "repeat-accelerating", "acceleration", "standing-correction"] },
          "arc_note": { "type": "string" },
          "attribution": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["study_exists", "no_study", "none_claimed", "natural_variability", "not_applicable"] },
              "note": { "type": "string" }
            }
          },
          "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
          "nl_eu": {
            "type": "object",
            "required": ["level"],
            "properties": {
              "level": { "type": "string", "enum": ["direct", "indirect", "none"] },
              "note": { "type": "string" }
            }
          },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
          "dropped": { "type": "string", "description": "Anything cut for failing verification, and why." }
        }
      }
    },

    "salience": {
      "type": "array",
      "description": "Section C. One entry per jurisdiction, every week, even when nothing moved.",
      "items": {
        "type": "object",
        "required": ["jurisdiction", "direction", "claims"],
        "properties": {
          "jurisdiction": { "type": "string", "enum": ["Netherlands", "EU", "US", "China", "India", "Multilateral"], "description": "Fixed list. One entry every week, each one. Private sector is an actor_type on the claims, not a jurisdiction." },
          "direction": { "type": "string", "enum": ["rising", "falling", "stable", "mixed", "no_change", "gap"] },
          "direction_note": { "type": "string" },
          "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
          "method_note": { "type": "string" },
          "rests_on": { "type": "array", "items": { "type": "string" }, "description": "e.g. ['D1'] where a judgement depends on a player move." }
        }
      }
    },

    "moves": {
      "type": "array",
      "description": "Section D. Player moves. Three-way labelling does not apply here.",
      "items": {
        "type": "object",
        "required": ["n", "title", "body", "verdict"],
        "properties": {
          "n": { "type": "integer" },
          "id": { "type": "string", "description": "Stable slug. Reuse it in later weeks when the outcome resolves." },
          "title": { "type": "string" },
          "actor": { "type": "string" },
          "date": { "type": "string" },
          "place": { "type": "string" },
          "body": { "type": "string" },
          "stated_rationale": { "type": "string" },
          "inference": { "type": "string" },
          "verdict": { "type": "string", "enum": ["landed", "failed", "too_early"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
        }
      }
    },

    "roster_silences": { "type": "string", "description": "Optional markdown. Institutions that published nothing." },

    "watch": {
      "type": "array",
      "description": "Things to watch next week.",
      "items": {
        "type": "object",
        "required": ["title", "note"],
        "properties": {
          "title": { "type": "string" },
          "note": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },

    "continuity": {
      "type": "object",
      "required": ["active_trends", "open_threads", "open_moves"],
      "properties": {
        "literature_covered": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "next_reading": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "active_trends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "first_raised": { "type": "string" }
            }
          }
        },
        "open_threads": {
          "type": "array",
          "description": "Unresolved questions. Carry every still-open thread forward each week with the SAME id.",
          "items": {
            "type": "object",
            "required": ["id", "text", "status"],
            "properties": {
              "id": { "type": "string", "description": "Stable slug, e.g. 'psi-funding-phase'. Never renumber." },
              "text": { "type": "string" },
              "status": { "type": "string", "enum": ["open", "resolved", "abandoned"] },
              "first_raised": { "type": "string" },
              "resolved_on": { "type": "string" },
              "resolution": { "type": "string" }
            }
          }
        },
        "open_moves": {
          "type": "array",
          "description": "Moves from any week whose outcome is still open. Same id as the move in section D.",
          "items": {
            "type": "object",
            "required": ["id", "text", "status"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "status": { "type": "string", "enum": ["open", "resolved"] },
              "opened": { "type": "string" },
              "resolved_on": { "type": "string" },
              "resolution": { "type": "string" }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "claim": {
      "type": "object",
      "description": "The three-way distinction, made machine-readable. 'gap' is for a verified absence.",
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string", "enum": ["evidence", "contested", "framing", "gap"] },
        "text": { "type": "string" },
        "actor_type": {
          "type": "string",
          "enum": ["government", "defence", "public_opinion", "private_sector", "other"],
          "description": "Required on salience claims. The second axis of section C."
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "publisher": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["author", "year", "title", "verification"],
      "properties": {
        "author": { "type": "string" },
        "year": { "type": "integer" },
        "title": { "type": "string" },
        "venue": { "type": "string" },
        "locator": { "type": "string", "description": "Volume, issue, pages." },
        "doi": { "type": "string" },
        "url": { "type": "string" },
        "verification": { "type": "string", "enum": ["verified", "partial", "unverified"] },
        "verification_note": { "type": "string" }
      }
    }
  }
}
